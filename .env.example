# =============================================================================
# Binance Payment Verifier — example configuration. NO REAL SECRETS HERE.
# Copy to .env (git-ignored) and fill in. In production use your secret manager.
# =============================================================================

# --- Application ---------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
# ENABLE_DOCS=                      # default: true outside production, false in production

# --- Database: Supabase (managed PostgreSQL, the single source of truth) --------
# Supabase dashboard -> Connect -> copy a connection string and paste it as-is
# (postgres:// or postgresql:// are accepted; the psycopg driver is selected for you).
#  * Session pooler (recommended for API + worker, IPv4):
#    postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#  * Direct connection (IPv6 only unless the IPv4 add-on is enabled):
#    postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
#  * Transaction pooler (port 6543, serverless): supported (no prepared statements,
#    transaction-scoped sync locks); use the session pooler or direct URL for migrations.
# TLS (sslmode=require) is enforced automatically for Supabase hosts.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL_MODE=                  # default: require for Supabase; e.g. verify-full + sslrootcert
DATABASE_POOLER_MODE=               # session | transaction (default: auto, 6543 = transaction)
DATABASE_POOL_SIZE=10               # keep within your Supabase plan's connection limit
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- API security ----------------------------------------------------------------
# Comma-separated, >= 32 chars each. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=
ADMIN_API_KEYS=
CORS_ALLOWED_ORIGINS=               # empty = CORS closed (recommended for server-to-server)
ALLOWED_HOSTS=                      # e.g. api.example.com (enables TrustedHost check)
TRUST_FORWARDED_HEADERS=false       # true only behind a trusted reverse proxy
MAX_REQUEST_BODY_BYTES=16384
RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=10

# --- Credential encryption (AES-256-GCM) ------------------------------------------
# 32 random bytes, base64. Generate: python -c "from app.core.encryption import generate_key;print(generate_key())"
# Required in production. Losing it makes stored OAuth refresh tokens unreadable.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_PREVIOUS_KEYS=   # old keys during rotation (comma-separated)

# --- Gmail account ------------------------------------------------------------------
GMAIL_EMAIL=
GMAIL_AUTH_METHOD=app_password      # app_password | oauth2
GMAIL_MAILBOX=INBOX                 # or a label, e.g. "Binance" (if you filter mails into it)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

# Method A — Google App Password (16 letters). NEVER your normal Google password.
GMAIL_APP_PASSWORD=

# Method B — OAuth2 / XOAUTH2 (refresh token stored ENCRYPTED in PostgreSQL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api.example.com/v1/admin/mail/oauth/callback
# GMAIL_OAUTH_REFRESH_TOKEN=        # optional: seed a refresh token (stored encrypted)

# Normal account password: implemented but DISABLED. Do not enable.
GMAIL_ACCOUNT_PASSWORD_AUTH_ENABLED=false
# GMAIL_ACCOUNT_PASSWORD=

# --- Mail synchronization ----------------------------------------------------------
MAIL_INITIAL_LOOKBACK_HOURS=48
MAIL_SYNC_INTERVAL_SECONDS=15
MAIL_SYNC_MAX_MESSAGES_PER_RUN=200
MAIL_IMAP_TIMEOUT_SECONDS=15
MAIL_IMAP_MAX_RETRIES=2
MAIL_IMAP_RETRY_BACKOFF_SECONDS=1
MAIL_ON_DEMAND_SYNC_ENABLED=true
MAIL_ON_DEMAND_MIN_INTERVAL_SECONDS=3
MAIL_SYNC_LOCK_WAIT_SECONDS=10
RUN_SYNC_WORKER_IN_API=false        # true = run the periodic sync inside the API process
STORE_RAW_EMAILS=false              # debugging only; stored ENCRYPTED when enabled

# --- Payment evidence source -----------------------------------------------------------
# binance_api (recommended): Binance Pay trade history API, gives the transactionId.
# email: Binance notification emails (real emails do NOT include the transactionId).
PAYMENT_EVIDENCE_SOURCE=binance_api

# --- Binance account API (GET /sapi/v1/pay/transactions) --------------------------------
# Binance -> API Management -> create key with ONLY "Enable Reading" (+ IP whitelist).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_API_SYNC_INTERVAL_SECONDS=15     # worker polling interval
BINANCE_API_MIN_INTERVAL_SECONDS=5       # min spacing between calls across ALL replicas
BINANCE_API_INITIAL_LOOKBACK_HOURS=48
BINANCE_API_OVERLAP_SECONDS=300          # re-read window to catch late-indexed transfers
BINANCE_PAY_ORDER_TYPES=C2C              # incoming types accepted as payments

# --- Binance email identification (only for PAYMENT_EVIDENCE_SOURCE=email) ---------------
# Observed in a real "Payment Receive Successful" email (DKIM d=directmail.binance.com).
BINANCE_ALLOWED_SENDERS=donotreply@directmail.binance.com
BINANCE_ALLOWED_DOMAINS=            # exact domains; prefix "*." to also allow subdomains
BINANCE_ALLOW_SIMULATED_TEMPLATES=  # default: true outside production, false in production
BINANCE_ENABLED_TEMPLATES=          # empty = all allowed templates

# --- Email trust policy --------------------------------------------------------------
EMAIL_TRUSTED_AUTHSERV_IDS=mx.google.com
EMAIL_REQUIRE_AUTHENTICATION_RESULTS=true
EMAIL_REQUIRE_DKIM=true
EMAIL_REQUIRE_DKIM_ALIGNMENT=true
EMAIL_REQUIRE_SPF=true
EMAIL_REQUIRE_DMARC=true

# --- Payment verification ------------------------------------------------------------
DEFAULT_ASSET=USDT
DEFAULT_PAYMENT_MAX_AGE_MINUTES=60
MAX_PAYMENT_AGE_MINUTES=1440
PAYMENT_CLOCK_SKEW_SECONDS=300
PAYMENT_CODE_CASE_INSENSITIVE=true  # Binance Pay transaction ids are uppercase-only
PAYMENT_AMOUNT_TOLERANCE=0          # 0 = exact match. Any other value is an explicit choice.
