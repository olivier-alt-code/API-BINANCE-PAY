# ----------------------------------------------------------------------------------------
# Copy to .env for local runs. On Azure, set these as Application settings instead.
# ----------------------------------------------------------------------------------------
APP_ENV=production                 # "development" relaxes the required-settings checks
SITE_NAME=Binance Pay Verifier
SUPPORT_CONTACT=                   # e.g. soporte@tudominio.com or @tu_telegram

# Database: Supabase transaction pooler (port 6543). Tables go to their own schema.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_SCHEMA=saas
DB_POOL_MAX=3

# The verification API this site sells
VERIFIER_API_URL=https://<tu-api>.azurewebsites.net
VERIFIER_ADMIN_KEY=                # = one of the API's ADMIN_API_KEYS
VERIFIER_TOKEN=                    # bpv_... token of YOUR client (the account that receives payments)
PUBLIC_API_URL=                    # optional: API URL shown in the docs (default VERIFIER_API_URL)
PAYMENT_MAX_AGE_MINUTES=           # optional: <= the API's MAX_PAYMENT_AGE_MINUTES

# Plan
PRICE_USDT=5
PERIOD_DAYS=30

# Where buyers pay (your Binance account that receives the USDT)
PAY_TO_ID=                         # Binance Pay ID
PAY_TO_NAME=                       # alias shown in Binance, e.g. Lea_tmi
PAY_QR_URL=                        # optional https:// image of your Binance Pay QR

# Web
SESSION_SECRET=                    # python -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECURE=true                 # false only for local http://
SWEEP_INTERVAL_SECONDS=300         # how often expired subscriptions are paused
